# Vexon OS — environment variables
# Copy to .env for the Vite app. Edge-function secrets are set with
# `supabase secrets set NAME=value` (or in supabase/functions/.env for `supabase functions serve`).

# ── Vite app (browser) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321            # Supabase API URL (local: supabase start prints it)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY  # anon / publishable key used by the browser client
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY         # same value; read by one legacy helper
VITE_SUPABASE_PROJECT_ID=vexon-os                     # project ref; used to build dashboard/function links

# ── Supabase (edge functions; injected automatically on hosted Supabase) ──────
SUPABASE_URL=http://127.0.0.1:54321                  # API URL inside functions
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY             # anon key for user-scoped clients
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY      # service-role key for admin writes (never ship to the browser)
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY      # alias kept for parity with the hosted build

# ── App ───────────────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:8080                     # public origin used in emails and OAuth redirects
INTERNAL_FUNCTION_SECRET=change-me                   # shared secret for function-to-function calls

# ── Close CRM ─────────────────────────────────────────────────────────────────
CLOSE_API_KEY=                                       # default Close API key (fulfilment org)
CLOSE_API_KEY_ACQUISITION=                           # Close key for the acquisition org
CLOSE_API_KEY_FULFILMENT=                            # Close key for the fulfilment org
CLOSE_API_KEY_HR=                                    # Close key for the hiring org
CLOSE_API_KEY_TRIAL=                                 # Close key for the trial-day org
CLOSE_SIGNATURE_KEY=                                 # Close webhook signature key (close-webhook)

# ── Google ────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=                              # Calendar connect (Kronos) OAuth client
GOOGLE_OAUTH_CLIENT_SECRET=                          # Calendar connect OAuth secret
GOOGLE_SERVICE_ACCOUNT_JSON=                         # service account JSON (Sheets sync)
GOOGLE_SHEETS_KEY=                                   # Sheets API key (read-only sheet imports)

# ── Microsoft ─────────────────────────────────────────────────────────────────
MICROSOFT_OAUTH_CLIENT_ID=                           # Entra app for Outlook/Teams calendar connect
MICROSOFT_OAUTH_CLIENT_SECRET=                       # Entra app secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=                                      # Resend API key
RESEND_FROM="Vexon OS <bookings@send.example.com>"   # default From for booking/system mail
RESEND_REPLY_TO=                                     # default Reply-To
CLIENT_WELCOME_FROM=                                 # From for client onboarding mail (falls back to RESEND_FROM)
CLIENT_WELCOME_REPLY_TO=                             # Reply-To for client onboarding mail
INVOICE_FROM=                                        # From for client invoices
INVOICE_REPLY_TO=                                    # Reply-To for client invoices
INVOICE_ASSET_BASE=http://localhost:8080/brand/invoice  # where the invoice PDF fetches fonts + logo
PAYSLIP_FROM=                                        # From for payslips
PAYSLIP_REPLY_TO=                                    # Reply-To for payslips

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                                  # Twilio account SID
TWILIO_AUTH_TOKEN=                                   # Twilio auth token
TWILIO_FROM_NUMBER=                                  # E.164 sender number

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                                   # call review / CV screening models
AI_GATEWAY_API_KEY=                                  # key for the OpenAI-compatible gateway
AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions  # OpenAI-compatible chat endpoint

# ── Integrations and webhooks ─────────────────────────────────────────────────
CANDIDATE_INTAKE_SECRET=                             # secret on the candidate intake endpoint
CV_SCREENING_INGEST_SECRET=                          # secret on the CV screening ingest endpoint
CLAY_WEBHOOK_URL=                                    # Clay table webhook for enrichment requests
CLAY_CALLBACK_SECRET=                                # secret Clay sends back on the callback
HEYREACH_API_KEY=                                    # HeyReach API key (LinkedIn outbound)
HEYREACH_WEBHOOK_SECRET=                             # HeyReach webhook secret
SMARTLEAD_API_KEY=                                   # Smartlead API key (email outbound)
SMARTLEAD_WEBHOOK_SECRET=                            # Smartlead webhook secret
KIT_API_KEY=                                         # Kit (ConvertKit) API key for nurture lists
N8N_WEBHOOK_SECRET=                                  # secret shared with n8n automations
N8N_ACQ_RESCAN_WEBHOOK_URL=                          # n8n webhook that re-scans acquisition leads
PANDADOC_CALLBACK_SECRET=                            # PandaDoc callback secret
PANDADOC_ONBOARDING_WEBHOOK_SECRET=                  # PandaDoc onboarding-contract webhook secret
PANDADOC_WEBHOOK_SHARED_KEY=                         # PandaDoc shared key (legacy webhook)
ZAPIER_PANDADOC_URL=                                 # Zapier hook fired when a contract is signed
ZAPIER_XERO_WEBHOOK_URL=                             # Zapier hook for Xero invoice sync
XERO_WEBHOOK_SECRET=                                 # Xero webhook signing key
TYPEFORM_WEBHOOK_SECRET=                             # legacy Typeform webhook secret
TRIALIST_API_KEY=                                    # key for the trialist intake endpoint
VEXON_BOOKINGS_CALENDAR=                             # calendar id used for shared booking holds
